    {
      "id": "u5bkLZi0WzkJCGMWjoIb6",
      "type": "text",
      "x": -3835.897702834812,
      "y": -5628.723479084113,
      "width": 1316.39892578125,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b10",
      "roundness": null,
      "seed": 244677590,
      "version": 785,
      "versionNonce": 616032000,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770025809854,
      "link": null,
      "locked": false,
      "text": "Module:\n- Was muss ich heute machen? (TODAY Module)\n- schnelle Todos\n- laengere Todos (innerhalb des naechsten Monats erlefigen)\n- wiederkehrende Todos (gewohnheitsliste (duschen/haare schneiden)) wenn man sich sachen angewoehnen will kann man die hinzufuegen\n- Ideen/Ich schreib mir was von der Seele zum spaeter angucken/sortieren\n- zu dem Ideending ein Modul wo man projekte erstellen kann und in die erste planung gehen kann\n- Finanzen\n- CRM (geburtstage der einzelnen leute undso)\n- Kalender\n- Haushalt regeln (Putzplan etc)\n- Essen regeln (Rezept und Essensplanung + Kalorienzaehlen)\n- gewohnheitstracker (bunte punkte die zeigen wann man gut war und wann nicht)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Module:\n- Was muss ich heute machen? (TODAY Module)\n- schnelle Todos\n- laengere Todos (innerhalb des naechsten Monats erlefigen)\n- wiederkehrende Todos (gewohnheitsliste (duschen/haare schneiden)) wenn man sich sachen angewoehnen will kann man die hinzufuegen\n- Ideen/Ich schreib mir was von der Seele zum spaeter angucken/sortieren\n- zu dem Ideending ein Modul wo man projekte erstellen kann und in die erste planung gehen kann\n- Finanzen\n- CRM (geburtstage der einzelnen leute undso)\n- Kalender\n- Haushalt regeln (Putzplan etc)\n- Essen regeln (Rezept und Essensplanung + Kalorienzaehlen)\n- gewohnheitstracker (bunte punkte die zeigen wann man gut war und wann nicht)",
      "autoResize": true,
      "lineHeight": 1.25
    },
